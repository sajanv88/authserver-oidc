{
  "name": "auth-server-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter tests e2e",
    "lint": "biome check . && stylelint \"**/*.scss\" --allow-empty-input",
    "lint:fix": "biome check --write . && stylelint \"**/*.scss\" --allow-empty-input --fix",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:check": "pnpm --filter @repo/db db:check",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:seed": "pnpm --filter auth-server db:seed",
    "email:dev": "pnpm --filter auth-server email:dev",
    "clients:provision": "pnpm --filter auth-server clients:provision",
    "db:studio": "pnpm --filter @repo/db db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "postcss": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard-scss": "catalog:",
    "turbo": "2.11.9"
  }
}
