# Copy to .env for local development (`.env` is git-ignored).
# In Kubernetes these come from the chart's ConfigMap and an existing Secret, never from a file.

# --- Secret ---
# Postgres 17. Local: compose.yaml, or any test database you have.
DATABASE_URL=postgres://app:app@127.0.0.1:5432/auth-server
# At least 32 random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# SMTP password or API token (required when EMAIL_PROVIDER=smtp).
SMTP_PASSWORD=
# Cloudflare Turnstile's secret key. Turnstile is off unless both TURNSTILE_* keys are set.
TURNSTILE_SECRET_KEY=
# Sign-in providers' client secrets: each provider is on when its ID (below) and secret are set.
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_SECRET=
SSO_CLIENT_SECRET=

# --- Config ---
# Public base URL of the auth server (also the OIDC issuer).
BETTER_AUTH_URL=http://auth.localtest.me:3000
# Parent domain for the shared session cookie. Empty turns cross-subdomain cookies off.
COOKIE_DOMAIN=.localtest.me
# Every app origin allowed to call the auth server, comma-separated. No wildcards.
TRUSTED_ORIGINS=http://app.localtest.me:3001
# console (dev: emails are printed to the log) or smtp (e.g. Cloudflare SMTP).
EMAIL_PROVIDER=console
EMAIL_FROM=Auth <no-reply@localtest.me>
# Used only when EMAIL_PROVIDER=smtp. Port 465 = implicit TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Cloudflare Turnstile on every form that takes typed input, and on the auth endpoints behind
# them. Empty (with TURNSTILE_SECRET_KEY) turns it off. Cloudflare's test keys, which always
# pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
# Sign-in with another account. Register this redirect URI with each provider:
#   <BETTER_AUTH_URL>/api/auth/callback/<google | microsoft | github | sso>
# e.g. http://auth.localtest.me:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
MICROSOFT_CLIENT_ID=
# common (work and personal accounts), organizations, consumers, or your tenant's ID.
# A work account's email is trusted (linked to an existing account, no confirmation email)
# only from that one tenant, or when the app registration adds the optional ID token claim
# xms_edov: any organisation's admin can set any address on their own users.
MICROSOFT_TENANT_ID=common
# Any OpenID Connect provider (Okta, Keycloak, Auth0, Entra ID…). The button says
# "Continue with <SSO_NAME>". All four SSO_* settings, or none.
SSO_NAME=
SSO_DISCOVERY_URL=
SSO_CLIENT_ID=

# --- APIs (optional): what apps may get access tokens for, besides signing people in ---
# Comma separated resource URIs (RFC 8707); a token for one is a JWT with that `aud`.
OAUTH_RESOURCES=
# API scopes offered beside openid, profile, email and offline_access, e.g. crm,booking
OAUTH_API_SCOPES=

# Optional: the product's name on every page, in titles, emails and authenticator apps.
# Empty for "Auth Server".
APP_NAME=
# Optional: your logo instead of the shield, on every page and as the tab's icon (a full URL,
# https in production), shown at 32 px, so a square image looks best.
LOGO_URL=
# Optional: an OpenTelemetry collector (OTLP over HTTP) for traces and metrics, web vitals
# included. Unset: nothing is exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# `pnpm clients:provision <file>` creates the clients a file declares, as this admin
# (see apps/auth-server/scripts/clients.example.json).
PROVISION_ADMIN_EMAIL=admin@localtest.me

# --- Local seed (`pnpm db:seed`): an admin and the example client's registration ---
SEED_ADMIN_EMAIL=admin@localtest.me
# At least 12 characters. If the admin already exists, its current password.
SEED_ADMIN_PASSWORD=

# --- Example client (apps/example-client, http://app.localtest.me:3001) ---
EXAMPLE_AUTH_SERVER_URL=http://auth.localtest.me:3000
EXAMPLE_APP_URL=http://app.localtest.me:3001
# From /admin/clients (or `pnpm db:seed`). Redirect URI: http://app.localtest.me:3001/oidc/callback
EXAMPLE_CLIENT_ID=
# Only for a confidential client; empty for a public one (PKCE only).
EXAMPLE_CLIENT_SECRET=
# Encrypts the example's own cookies. At least 32 characters: `openssl rand -base64 32`
EXAMPLE_SESSION_SECRET=
