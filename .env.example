# Copy to .env for local development (`.env` is git-ignored).
# In Kubernetes these come from the chart's ConfigMap and an existing Secret, never from a file.

# --- Secret ---
# Postgres 17. Local: compose.yaml, or any test database you have.
DATABASE_URL=postgres://app:app@127.0.0.1:5432/auth-server
# At least 32 random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# --- Config ---
# Public base URL of the auth server (also the OIDC issuer).
BETTER_AUTH_URL=http://auth.localtest.me:3000
# Parent domain for the shared session cookie. Empty turns cross-subdomain cookies off.
COOKIE_DOMAIN=.localtest.me
# Every app origin allowed to call the auth server, comma-separated. No wildcards.
TRUSTED_ORIGINS=http://app.localtest.me:3001
# console (dev) or resend (prod; then RESEND_API_KEY is required in the Secret).
EMAIL_PROVIDER=console
EMAIL_FROM=Auth <no-reply@localtest.me>
