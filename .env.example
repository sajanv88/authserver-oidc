# Copy to .env for local development (`.env` is git-ignored).
# In Kubernetes these come from the chart's ConfigMap and an existing Secret, never from a file.

# --- Secret ---
# Postgres 17. Local: compose.yaml, or any test database you have.
DATABASE_URL=postgres://app:app@127.0.0.1:5432/auth-server
# At least 32 random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# SMTP password or API token (required when EMAIL_PROVIDER=smtp).
SMTP_PASSWORD=
# Cloudflare Turnstile's secret key. Turnstile is off unless both TURNSTILE_* keys are set.
TURNSTILE_SECRET_KEY=

# --- Config ---
# Public base URL of the auth server (also the OIDC issuer).
BETTER_AUTH_URL=http://auth.localtest.me:3000
# Parent domain for the shared session cookie. Empty turns cross-subdomain cookies off.
COOKIE_DOMAIN=.localtest.me
# Every app origin allowed to call the auth server, comma-separated. No wildcards.
TRUSTED_ORIGINS=http://app.localtest.me:3001
# console (dev: emails are printed to the log) or smtp (e.g. Cloudflare SMTP).
EMAIL_PROVIDER=console
EMAIL_FROM=Auth <no-reply@localtest.me>
# Used only when EMAIL_PROVIDER=smtp. Port 465 = implicit TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Cloudflare Turnstile on every form that takes typed input, and on the auth endpoints behind
# them. Empty (with TURNSTILE_SECRET_KEY) turns it off. Cloudflare's test keys, which always
# pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=

# --- Local seed (`pnpm db:seed`): an admin and the example client's registration ---
SEED_ADMIN_EMAIL=admin@localtest.me
# At least 12 characters. If the admin already exists, its current password.
SEED_ADMIN_PASSWORD=

# --- Example client (apps/example-client, http://app.localtest.me:3001) ---
EXAMPLE_AUTH_SERVER_URL=http://auth.localtest.me:3000
EXAMPLE_APP_URL=http://app.localtest.me:3001
# From /admin/clients (or `pnpm db:seed`). Redirect URI: http://app.localtest.me:3001/oidc/callback
EXAMPLE_CLIENT_ID=
# Only for a confidential client; empty for a public one (PKCE only).
EXAMPLE_CLIENT_SECRET=
# Encrypts the example's own cookies. At least 32 characters: `openssl rand -base64 32`
EXAMPLE_SESSION_SECRET=
