{
  "name": "auth-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "analyze": "next analyze",
    "test": "vitest run",
    "seed:build": "esbuild scripts/seed.ts --bundle --platform=node --format=esm --target=node26 --outfile=dist/seed.mjs --external:pg-native --external:next --alias:server-only=./test/server-only.ts --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "db:seed": "pnpm run seed:build && node --env-file-if-exists=../../.env dist/seed.mjs",
    "clients:build": "esbuild scripts/provision-clients.ts --bundle --platform=node --format=esm --target=node26 --outfile=dist/provision-clients.mjs --external:pg-native --external:next --alias:server-only=./test/server-only.ts --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "clients:provision": "pnpm run clients:build && node --env-file-if-exists=../../.env dist/provision-clients.mjs"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "catalog:",
    "@nuvui/backgrounds": "catalog:",
    "@nuvui/barcodes": "catalog:",
    "@nuvui/icons": "catalog:",
    "@nuvui/react": "catalog:",
    "@nuvui/table": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "catalog:",
    "@opentelemetry/instrumentation": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@repo/db": "workspace:*",
    "@tanstack/react-table": "catalog:",
    "@vercel/otel": "catalog:",
    "better-auth": "catalog:",
    "next": "catalog:",
    "nodemailer": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "esbuild": "catalog:",
    "jose": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
