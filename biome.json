{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/.next",
      "!!**/.turbo",
      "!!**/dist",
      "!!**/coverage",
      "!**/next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": "error",
      "nursery": "off",
      "suspicious": {
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["error", "warn"]
          }
        }
      }
    },
    "domains": {
      "react": "recommended",
      "next": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.test-d.ts"],
      "linter": {
        "domains": {
          "test": "recommended"
        }
      }
    },
    {
      "includes": ["apps/auth-server/src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features", "@/features/**", "**/features/**"],
                    "message": "shared/ never imports from features/: move the code into shared, or pass it in from the caller."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/auth-server/src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*/**"],
                    "message": "Import a feature only through its public API: @/features/<name> (its index.ts)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/auth-server/src/features/*/*.ts", "apps/auth-server/src/features/*/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*/**"],
                    "message": "Import a feature only through its public API: @/features/<name> (its index.ts). Inside a feature, use relative imports."
                  },
                  {
                    "group": ["../**"],
                    "message": "A feature never reaches out of its own folder: other features through @/features/<name>, shared code through @/shared/..."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/auth-server/src/features/*/*/*.ts",
        "apps/auth-server/src/features/*/*/*.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*/**"],
                    "message": "Import a feature only through its public API: @/features/<name> (its index.ts). Inside a feature, use relative imports."
                  },
                  {
                    "group": ["../../**"],
                    "message": "A feature never reaches out of its own folder: other features through @/features/<name>, shared code through @/shared/..."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/auth-server/src/features/*/*/*/*.ts",
        "apps/auth-server/src/features/*/*/*/*.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*/**"],
                    "message": "Import a feature only through its public API: @/features/<name> (its index.ts). Inside a feature, use relative imports."
                  },
                  {
                    "group": ["../../../**"],
                    "message": "A feature never reaches out of its own folder: other features through @/features/<name>, shared code through @/shared/..."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/auth-server/src/features/*/*/*/*/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*/**"],
                    "message": "Import a feature only through its public API: @/features/<name> (its index.ts). Inside a feature, use relative imports."
                  },
                  {
                    "group": ["../../../../**"],
                    "message": "A feature never reaches out of its own folder: other features through @/features/<name>, shared code through @/shared/..."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
