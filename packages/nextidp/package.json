{
  "name": "nextidp",
  "version": "0.1.4",
  "description": "Sign people in to Next.js, Express, Hono and Node apps, and protect NestJS, Express, Hono and Next.js APIs, with authserver-oidc, in one call. Runs on Node and edge runtimes.",
  "keywords": [
    "oidc",
    "openid-connect",
    "oauth2",
    "authentication",
    "nextjs",
    "nestjs",
    "express",
    "hono",
    "cloudflare-workers",
    "edge",
    "jwt",
    "idp"
  ],
  "homepage": "https://sajanv88.github.io/authserver-oidc/docs/#nextidp",
  "bugs": "https://github.com/sajanv88/authserver-oidc/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sajanv88/authserver-oidc.git",
    "directory": "packages/nextidp"
  },
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "typesVersions": {
    "*": {
      "next": [
        "./dist/cjs/next.d.ts"
      ],
      "express": [
        "./dist/cjs/express.d.ts"
      ],
      "node": [
        "./dist/cjs/node.d.ts"
      ],
      "hono": [
        "./dist/cjs/hono.d.ts"
      ],
      "nestjs": [
        "./dist/cjs/nestjs.d.ts"
      ]
    }
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/esm/next.d.ts",
        "default": "./dist/esm/next.js"
      },
      "require": {
        "types": "./dist/cjs/next.d.ts",
        "default": "./dist/cjs/next.js"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/esm/express.d.ts",
        "default": "./dist/esm/express.js"
      },
      "require": {
        "types": "./dist/cjs/express.d.ts",
        "default": "./dist/cjs/express.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/esm/node.d.ts",
        "default": "./dist/esm/node.js"
      },
      "require": {
        "types": "./dist/cjs/node.d.ts",
        "default": "./dist/cjs/node.js"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/esm/hono.d.ts",
        "default": "./dist/esm/hono.js"
      },
      "require": {
        "types": "./dist/cjs/hono.d.ts",
        "default": "./dist/cjs/hono.js"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/esm/nestjs.d.ts",
        "default": "./dist/esm/nestjs.js"
      },
      "require": {
        "types": "./dist/cjs/nestjs.d.ts",
        "default": "./dist/cjs/nestjs.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:package": "publint --pack pnpm --strict && node scripts/check-types.ts"
  },
  "dependencies": {
    "fast-http-client": "catalog:nextidp",
    "jose": "catalog:nextidp",
    "valibot": "catalog:nextidp"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "hono": "^4.0.0",
    "next": "^15.0.0 || ^16.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@repo/tsconfig": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "express": "catalog:",
    "hono": "catalog:",
    "miniflare": "catalog:",
    "next": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
