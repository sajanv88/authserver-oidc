{
  "name": "nextidp",
  "version": "0.1.0",
  "description": "Sign people in to Next.js, Node and NestJS apps with authserver-oidc, in one call.",
  "keywords": [
    "oidc",
    "openid-connect",
    "oauth2",
    "authentication",
    "nextjs",
    "nestjs",
    "idp"
  ],
  "homepage": "https://sajanv88.github.io/authserver-oidc/docs/#nextidp",
  "bugs": "https://github.com/sajanv88/authserver-oidc/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sajanv88/authserver-oidc.git",
    "directory": "packages/nextidp"
  },
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/esm/next.d.ts",
        "default": "./dist/esm/next.js"
      },
      "require": {
        "types": "./dist/cjs/next.d.ts",
        "default": "./dist/cjs/next.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:package": "publint --pack pnpm --strict && node scripts/check-types.ts"
  },
  "dependencies": {
    "fast-http-client": "catalog:nextidp",
    "jose": "catalog:nextidp",
    "valibot": "catalog:nextidp"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "next": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
